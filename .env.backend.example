# Para que el backend mande mails reales: pegar acá el .env del backend (se pasa por privado,
# no se sube al repo), guardarlo como .env.backend y cambiar EMAIL_DEV_REDIRECT por tu correo.
# Sin este archivo, los mails se imprimen en `docker compose logs backend`.
EMAIL_BACKEND=smtp
EMAIL=
EMAIL_PASSWORD=
# Tu correo institucional: todos los mails que mande el sistema te llegan a vos,
# sea quien sea el destinatario. Cada integrante pone el suyo.
EMAIL_DEV_REDIRECT=
