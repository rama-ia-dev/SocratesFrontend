# Copiar como .env.backend (no se sube al repo) para que el backend mande mails reales.
# Sin este archivo, los mails se imprimen en `docker compose logs backend`.
EMAIL_BACKEND=smtp
EMAIL=
EMAIL_PASSWORD=
# Tu correo institucional: todos los mails que mande el sistema te llegan a vos,
# sea quien sea el destinatario. Cada integrante pone el suyo.
EMAIL_DEV_REDIRECT=
