# Copiar como .env.local y ajustar. Ninguna de estas variables es secreta.

# true: las pantallas usan datos simulados en memoria (no hace falta el backend).
# false: se conecta al backend real a través del proxy de Vite.
VITE_USE_MOCK=false

# Dónde corre el backend en desarrollo (lo usa el proxy de vite.config.ts).
VITE_BACKEND_URL=http://localhost:8000
